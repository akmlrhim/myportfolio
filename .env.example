WAKATIME_API=

VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Groq AI chat. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Leave empty to use the account default (openai/gpt-oss-120b).
# Must be a model your Groq account can access: https://console.groq.com/docs/models
# Rejected models (typo or no access) fall back automatically.
GROQ_MODEL=
# Token protection. Defaults are sane for a free-tier portfolio; raise them
# only if real visitors keep hitting the limits.
# AI_RATE_PER_MINUTE=6
# AI_RATE_PER_HOUR=20
# AI_RATE_PER_DAY=60
# AI_DAILY_REQUEST_BUDGET=300
# AI_DAILY_TOKEN_BUDGET=250000
